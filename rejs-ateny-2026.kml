<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"><Document>
<name>Rejs Ateny–Ateny 10–17.10</name>
<description>Atrakcje i warianty trasy</description>
<Style id="p_port"><IconStyle><color>ff2e57e4</color><scale>1.1</scale>
<Icon><href>http://maps.google.com/mapfiles/kml/shapes/placemark_circle.png</href></Icon></IconStyle>
<LabelStyle><scale>0.9</scale></LabelStyle></Style>
